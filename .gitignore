node_modules
dist
.DS_Store
*.local
.vite

# Python (python/)
python/.venv
python/**/__pycache__
python/**/*.pyc
python/.pytest_cache
python/.ruff_cache
python/.mypy_cache

# Replays — written by the MLX training loop, served by Vite as static files.
# Force-add specific ones with `git add -f` if you want to ship a demo replay.
public/replays/*.flxr
public/replays/*.flxr.tmp
public/replays/index.json
public/v2/replays/*.flxr
public/v2/replays/*.flxr.tmp
public/v2/replays/index.json
public/v2/replays/events.jsonl
public/v3/replays/*.flxr
public/v3/replays/*.flxr.tmp
public/v3/replays/index.json

# Training checkpoints — full evolution state, regenerated by every run.
python/checkpoints/

# wandb local run cache (synced to wandb.ai)
python/wandb/

# Auto-saved champion JSONs from the MLX evolution loop. Force-add a
# specific one (e.g. an all-time best worth pinning) with `git add -f`.
public/champions/gen*_b*_fit*.json
public/champions/v2/v2_gen*_b*_fit*.json
public/champions/v3/v3_gen*_b*_fit*.json

# Local Claude Code agent state (per-machine).
.claude/
probe.mjs
